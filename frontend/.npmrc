# Pin the public registry. Without this, npm inherits whatever registry the
# machine generating the lockfile used, which bakes an internal mirror into
# package-lock.json and 401s everywhere else.
registry=https://registry.npmjs.org/

# Turn the "engines" check into a hard error. npm 10 does not merely warn here:
# it crashes with "Cannot read properties of null (reading 'edgesOut')" while
# resolving vitest's peers. A clear refusal is far easier to diagnose.
engine-strict=true
